--- Environment variables (LR60).
import { bytesOf, stringFromBytes } from "std/mem"

@extern("c")
unsafe function getenv(name: *const u8): *const u8

#if target.family == "windows"
@extern("c")
unsafe function _putenv_s(name: *const u8, value: *const u8): i32
#else
@extern("c")
unsafe function setenv(name: *const u8, value: *const u8, overwrite: i32): i32

@extern("c")
unsafe function unsetenv(name: *const u8): i32
#end

@extern("c")
unsafe function strlen(text: *const u8): usize

@extern("c")
unsafe function malloc(size: usize): *mut u8

@extern("c")
unsafe function free(block: *mut u8)

export function get(name: string): string?
    unsafe
        local key = cString(name)
        local value = getenv(key)
        free(key)
        if value as usize == 0 then
            return nil
        end
        return stringFromBytes(value, strlen(value) as int)
    end
end

export function set(name: string, value: string): Result<(), Error>
    unsafe
        if containsZero(name) or containsZero(value) then
            return Result.Err(Error("environment names and values cannot contain a zero byte"))
        end

        local key = cString(name)
        local stored = cString(value)
        #if target.family == "windows"
        local failed = _putenv_s(key, stored) ~= 0
        #else
        local failed = setenv(key, stored, 1) ~= 0
        #end
        free(key)
        free(stored)
        if failed then
            return Result.Err(Error(`cannot set environment variable {name}`))
        end
        return Result.Ok(())
    end
end

export function remove(name: string): Result<(), Error>
    unsafe
        if containsZero(name) then
            return Result.Err(Error("environment names cannot contain a zero byte"))
        end

        local key = cString(name)
        #if target.family == "windows"
        local empty = cString("")
        local failed = _putenv_s(key, empty) ~= 0
        free(empty)
        #else
        local failed = unsetenv(key) ~= 0
        #end
        free(key)
        if failed then
            return Result.Err(Error(`cannot remove environment variable {name}`))
        end
        return Result.Ok(())
    end
end

unsafe function cString(text: string): *mut u8
    local length = text.byteLength
    local copy = malloc((length + 1) as usize)
    local source = bytesOf(text)
    for i in 0..<length do
        copy:add(i as isize):write(source:add(i as isize):read())
    end
    copy:add(length as isize):write(0)
    return copy
end

unsafe function containsZero(text: string): bool
    local data = bytesOf(text)
    for i in 0..<text.byteLength do
        if data:add(i as isize):read() == 0 then
            return true
        end
    end
    return false
end
