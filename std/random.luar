--- Deterministic random values (STD12).

export ref struct Random
    private state: u64

    static function seeded(seed: u64): Random
        return Random { state = seed }
    end

    function nextU64(self): u64
        self.state = self.state:wrappingAdd(0x9E3779B97F4A7C15)
        local value = self.state
        value = (value ^ (value >> 30)):wrappingMul(0xBF58476D1CE4E5B9)
        value = (value ^ (value >> 27)):wrappingMul(0x94D049BB133111EB)
        return value ^ (value >> 31)
    end

    function nextBool(self): bool
        return (self:nextU64() & 1) == 1
    end

    function nextFloat(self): float
        return (self:nextU64() >> 11) as float / 9007199254740992.0
    end

    function uint(self, low: u64, high: u64): u64
        assert(low < high)
        local width = high - low
        local zero: u64 = 0
        local threshold = zero:wrappingSub(width) % width
        while true do
            local value = self:nextU64()
            if value >= threshold then
                return low + value % width
            end
        end
    end

    function int(self, low: int, high: int): int
        assert(low < high)
        local sign: u64 = 0x8000000000000000
        local biasedLow = (low as u64) ^ sign
        local biasedHigh = (high as u64) ^ sign
        return (self:uint(biasedLow, biasedHigh) ^ sign) as int
    end

    function shuffle<T>(self, values: List<T>)
        local i = values.length - 1
        while i > 0 do
            local j = self:int(0, i + 1)
            local held = values[i]
            values[i] = values[j]
            values[j] = held
            i -= 1
        end
    end
end
