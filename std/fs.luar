--- Files (LR60).
import { bytesOf, stringFromBytes } from "std/mem"

@extern("c")
unsafe function fopen(path: *const u8, mode: *const u8): *mut u8

@extern("c")
unsafe function fread(buffer: *mut u8, size: usize, count: usize, file: *mut u8): usize

@extern("c")
unsafe function ferror(file: *mut u8): i32

@extern("c")
unsafe function fclose(file: *mut u8): i32

@extern("c")
unsafe function malloc(size: usize): *mut u8

@extern("c")
unsafe function realloc(block: *mut u8, size: usize): *mut u8

@extern("c")
unsafe function free(block: *mut u8)

export function readText(path: string): Result<string, Error>
    unsafe
        local name = cString(path)
        local mode = cString("rb")
        local file = fopen(name, mode)
        free(name)
        free(mode)
        if file as usize == 0 then
            return Result.Err(Error(`cannot open {path}`))
        end

        local capacity = 4096
        local length = 0
        local buffer = malloc(capacity as usize)
        while true do
            if length == capacity then
                capacity *= 2
                buffer = realloc(buffer, capacity as usize)
            end
            local read = fread(buffer:add(length as isize), 1, (capacity - length) as usize, file)
            if read == 0 then
                break
            end
            length += read as int
        end
        local failed = ferror(file) ~= 0
        fclose(file)

        if failed then
            free(buffer)
            return Result.Err(Error(`cannot read {path}`))
        end
        if not isUtf8(buffer, length) then
            free(buffer)
            return Result.Err(Error(`{path} is not UTF-8`))
        end
        local text = stringFromBytes(buffer, length)
        free(buffer)
        return Result.Ok(text)
    end
end

--- `text` copied into C storage with a zero byte after it.
unsafe function cString(text: string): *mut u8
    local length = text.byteLength
    local copy = malloc((length + 1) as usize)
    local source = bytesOf(text)
    for i in 0..<length do
        copy:add(i as isize):write(source:add(i as isize):read())
    end
    copy:add(length as isize):write(0)
    return copy
end

--- Whether `length` bytes at `data` are well-formed UTF-8: no overlong
--- forms, no surrogates, nothing past U+10FFFF.
unsafe function isUtf8(data: *const u8, length: int): bool
    local i = 0
    while i < length do
        local byte = data:add(i as isize):read()
        local width = 0
        if byte < 0x80 then
            width = 1
        elseif byte >= 0xC2 and byte <= 0xDF then
            width = 2
        elseif byte >= 0xE0 and byte <= 0xEF then
            width = 3
        elseif byte >= 0xF0 and byte <= 0xF4 then
            width = 4
        else
            return false
        end
        if i + width > length then
            return false
        end
        for k in 1..<width do
            local trailing = data:add((i + k) as isize):read()
            if trailing < 0x80 or trailing > 0xBF then
                return false
            end
        end
        if width >= 3 then
            local second = data:add((i + 1) as isize):read()
            if (byte == 0xE0 and second < 0xA0)
                or (byte == 0xED and second > 0x9F)
                or (byte == 0xF0 and second < 0x90)
                or (byte == 0xF4 and second > 0x8F) then
                return false
            end
        end
        i += width
    end
    return true
end
