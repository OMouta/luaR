--- The standard protocols (LR35) and the collection methods written in LuaR
--- (LR54.1). In scope in every module without an import.

export interface Eq
    function eq(self, other: Self): bool
end

export interface Hash
    function hash(self): u64
end

export interface Display
    function display(self): string
end

export interface Comparable
    function compare(self, other: Self): int
end

export interface Iterator<T>
    function next(self): T?
end

export interface Iterable<T>
    function iterator(self): Iterator<T>
end

export interface Index<K, V>
    function index(self, key: K): V
end

export interface Into<T>
    function into(self): T
end

ref struct EnumeratedIterator<T> implements Iterator<(int, T)>, Iterable<(int, T)>
    values: FrozenList<T>
    index: int

    function next(self): (int, T)?
        if self.index >= self.values.length then
            return nil
        end
        local item = (self.index, self.values[self.index])
        self.index += 1
        return item
    end

    function iterator(self): Iterator<(int, T)>
        return self
    end
end

export extend ListIteration<T> for List<T>
    function enumerated(self): Iterable<(int, T)>
        return EnumeratedIterator { values = self:frozen(), index = 0 }
    end
end

export extend FrozenListIteration<T> for FrozenList<T>
    function enumerated(self): Iterable<(int, T)>
        return EnumeratedIterator { values = self, index = 0 }
    end
end

export extend ListSearch<T> for List<T>
    function contains(self, value: T): bool
    where T: Eq
        for i in 0..<self.length do
            if self[i] == value then
                return true
            end
        end
        return false
    end

    function indexOf(self, value: T): int?
    where T: Eq
        for i in 0..<self.length do
            if self[i] == value then
                return i
            end
        end
        return nil
    end
end

export extend FrozenListSearch<T> for FrozenList<T>
    function contains(self, value: T): bool
    where T: Eq
        for i in 0..<self.length do
            if self[i] == value then
                return true
            end
        end
        return false
    end

    function indexOf(self, value: T): int?
    where T: Eq
        for i in 0..<self.length do
            if self[i] == value then
                return i
            end
        end
        return nil
    end
end

export extend ListMutation<T> for List<T>
    function insert(self, index: int, value: T)
        self:push(value)
        local i = self.length - 1
        while i > index do
            self[i] = self[i - 1]
            i -= 1
        end
        self[index] = value
    end

    function pushAll(self, other: List<T>)
        local count = other.length
        for i in 0..<count do
            self:push(other[i])
        end
    end

    function pushAll(self, other: FrozenList<T>)
        for i in 0..<other.length do
            self:push(other[i])
        end
    end

    function removeAt(self, index: int): T
        local removed = self[index]
        for i in index + 1..<self.length do
            self[i - 1] = self[i]
        end
        self:pop()
        return removed
    end

    function reverse(self)
        local low = 0
        local high = self.length - 1
        while low < high do
            local held = self[low]
            self[low] = self[high]
            self[high] = held
            low += 1
            high -= 1
        end
    end
end

export extend OptionalOr<T> for T?
    function okOr<E>(self, error: E): Result<T, E>
        if self ~= nil then
            return Result.Ok(self)
        end
        return Result.Err(error)
    end
end

export extend ResultMap<T, E> for Result<T, E>
    function mapErr<F>(self, map: (E) -> F): Result<T, F>
        match self
            case Result.Ok(value)
                return Result.Ok(value)
            case Result.Err(error)
                return Result.Err(map(error))
        end
    end
end
