--- The standard protocols (LR35) and the collection methods written in LuaR
--- (LR54.1). In scope in every module without an import.

export interface Eq
    function eq(self, other: Self): bool
end

export interface Hash
    function hash(self): u64
end

export interface Display
    function display(self): string
end

export interface Comparable
    function compare(self, other: Self): int
end

export extend ListSearch<T> for List<T>
    function contains(self, value: T): bool
    where T: Eq
        for i in 0..<self.length do
            if self[i] == value then
                return true
            end
        end
        return false
    end

    function indexOf(self, value: T): int?
    where T: Eq
        for i in 0..<self.length do
            if self[i] == value then
                return i
            end
        end
        return nil
    end
end

export extend FrozenListSearch<T> for FrozenList<T>
    function contains(self, value: T): bool
    where T: Eq
        for i in 0..<self.length do
            if self[i] == value then
                return true
            end
        end
        return false
    end

    function indexOf(self, value: T): int?
    where T: Eq
        for i in 0..<self.length do
            if self[i] == value then
                return i
            end
        end
        return nil
    end
end

export extend ListMutation<T> for List<T>
    function pushAll(self, other: List<T>)
        local count = other.length
        for i in 0..<count do
            self:push(other[i])
        end
    end

    function pushAll(self, other: FrozenList<T>)
        for i in 0..<other.length do
            self:push(other[i])
        end
    end

    function reverse(self)
        local low = 0
        local high = self.length - 1
        while low < high do
            local held = self[low]
            self[low] = self[high]
            self[high] = held
            low += 1
            high -= 1
        end
    end
end
