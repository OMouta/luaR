{
  "name": "luar-language",
  "displayName": "LuaR",
  "description": "Syntax highlighting and file support for LuaR.",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/OMouta/luaR.git",
    "directory": "editors/vscode"
  },
  "contributes": {
    "languages": [
      {
        "id": "luar",
        "aliases": [
          "LuaR",
          "luar"
        ],
        "extensions": [
          ".luar"
        ],
        "icon": {
          "light": "./icons/luaRLogo.svg",
          "dark": "./icons/luaRLogo.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "luar",
        "scopeName": "source.luar",
        "path": "./syntaxes/luar.tmLanguage.json"
      }
    ]
  }
}
