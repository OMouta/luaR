{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "LuaR",
  "scopeName": "source.luar",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#conditional-directives"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#decorators"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.luar",
          "match": "---(?!-).*$"
        },
        {
          "include": "#block-comment"
        },
        {
          "name": "comment.line.double-dash.luar",
          "match": "--.*$"
        }
      ]
    },
    "block-comment": {
      "name": "comment.block.luar",
      "begin": "--\\[(=*)\\[",
      "end": "\\]\\1\\]",
      "patterns": [
        {
          "include": "#block-comment"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.other.bytes.luar",
          "begin": "b\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.luar"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.luar"
            }
          },
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "name": "string.quoted.double.luar",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.luar"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.luar"
            }
          },
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "name": "string.quoted.single.character.luar",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.luar"
            }
          },
          "end": "'|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.luar"
            }
          },
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "include": "#interpolated-string"
        },
        {
          "name": "string.quoted.other.long.luar",
          "begin": "\\[(=*)\\[",
          "end": "\\]\\1\\]"
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.luar",
          "match": "\\\\(?:[nrt\\\\\"'`{0]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]{1,6}\\})"
        },
        {
          "name": "invalid.illegal.escape.luar",
          "match": "\\\\."
        }
      ]
    },
    "interpolated-string": {
      "name": "string.interpolated.luar",
      "begin": "`",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.luar"
        }
      },
      "end": "`|$",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.luar"
        }
      },
      "patterns": [
        {
          "include": "#escapes"
        },
        {
          "include": "#interpolation-hole"
        }
      ]
    },
    "interpolation-hole": {
      "name": "meta.interpolation.luar",
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.luar"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.luar"
        }
      },
      "contentName": "source.luar",
      "patterns": [
        {
          "include": "#balanced-braces"
        },
        {
          "include": "$self"
        }
      ]
    },
    "balanced-braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#balanced-braces"
        },
        {
          "include": "$self"
        }
      ]
    },
    "conditional-directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.luar",
          "match": "#(?:if|elseif|else|end)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(function)\\s+([_\\p{L}][_\\p{L}\\p{N}]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.luar"
            },
            "2": {
              "name": "entity.name.function.luar"
            }
          }
        },
        {
          "match": "\\b(structural\\s+)?(struct|interface|enum|type|decorator)\\s+([_\\p{L}][_\\p{L}\\p{N}]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.luar"
            },
            "2": {
              "name": "storage.type.luar"
            },
            "3": {
              "name": "entity.name.type.luar"
            }
          }
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "match": "(@)([_\\p{L}][_\\p{L}\\p{N}]*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.annotation.luar"
            },
            "2": {
              "name": "entity.name.function.decorator.luar"
            }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.luar",
          "match": "(?<![_\\p{L}\\p{N}])(?:[0-9](?:_?[0-9])*)?\\.[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9](?:_?[0-9])*)?|(?<![_\\p{L}\\p{N}])[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9](?:_?[0-9])*)"
        },
        {
          "name": "constant.numeric.integer.luar",
          "match": "(?<![_\\p{L}\\p{N}])(?:0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*|0[oO][0-7](?:_?[0-7])*|0[bB][01](?:_?[01])*|[0-9](?:_?[0-9])*)(?![_\\p{L}\\p{N}])"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "constant.language.luar",
          "match": "\\b(?:false|nil|true)\\b"
        },
        {
          "name": "keyword.operator.word.luar",
          "match": "\\b(?:and|as|is|not|or|typeof)\\b"
        },
        {
          "name": "keyword.control.luar",
          "match": "\\b(?:await|break|case|catch|continue|defer|do|else|elseif|end|finally|for|if|in|match|repeat|return|then|throw|try|until|while)\\b"
        },
        {
          "name": "storage.modifier.luar",
          "match": "\\b(?:async|export|internal|mut|private|public|ref|static|structural|unsafe)\\b"
        },
        {
          "name": "storage.type.luar",
          "match": "\\b(?:const|decorator|enum|extend|from|function|implements|import|interface|local|property|scope|struct|type|where)\\b"
        },
        {
          "name": "invalid.illegal.reserved.luar",
          "match": "\\b(?:comptime|effect|impl|macro|yield)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.luar",
          "match": "\\b(?:any|bool|bytes|char|f32|f64|float|i8|i16|i32|i64|int|isize|never|string|u8|u16|u32|u64|uint|unknown|usize)\\b"
        },
        {
          "name": "support.type.builtin.luar",
          "match": "\\b(?:Error|FrozenList|FrozenMap|FrozenSet|List|Map|Result|Set|Slice|Task)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.luar",
          "match": "\\.\\.\\.|\\.\\.<|\\.\\.=|\\.\\.|\\?\\.|\\?\\?|\\*\\*=|//=?|<<=?|>>=?|==|~=|<=|>=|=>|->|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|[+\\-*/%&|^~<>=?]"
        }
      ]
    }
  }
}
