function sum(first: int, ...rest: int): int
    local total = first
    for value in rest do
        total += value
    end
    return total
end

function count<T>(...values: T): int
    return values.length
end

export function main(): int
    return sum(1, 2, 3) + sum(4) + count(8, 9)
end
