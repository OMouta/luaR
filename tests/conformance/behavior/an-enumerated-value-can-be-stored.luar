export function main(): int
    local values = [2, 4, 6]
    local mutable = values:enumerated()
    local frozen = values:frozen():enumerated()
    local total = 0

    for index, value in mutable do
        total += index + value
    end
    for index, value in frozen do
        total += index + value
    end

    return total
end
