enum Shape
    Circle(int)
    Rect { width: int, height: int }
end

export function main(): int
    local shape = Shape.Rect { width = 5, height = 6 }
    match shape
        case Shape.Circle(radius)
            return radius
        case Shape.Rect { width, height }
            return width * height
    end
    return 0
end
