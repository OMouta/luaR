--- expect: run
--- exit: 0
--- stdout: "20\t30\n99\n99\n10\t40\n20\t99\n"
--- spec: LR38
export function main()
    local values = [10, 20, 30, 40]
    local middle = values[1..<3]
    print(middle[0], middle[1])

    middle[1] = 99
    print(values[2])

    local tail = middle[1..<]
    print(tail[0])

    local all = values[..<]
    print(all[0], all[3])

    local inclusive = values[1..=2]
    print(inclusive[0], inclusive[1])
end
