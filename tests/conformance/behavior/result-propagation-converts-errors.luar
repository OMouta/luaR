struct SourceError
    code: int

    function into(self): TargetError
        return TargetError { code = self.code }
    end
end

struct TargetError
    code: int
end

function convert(result: Result<int, SourceError>): Result<int, TargetError>
    local value = result?
    return Result.Ok<int, TargetError>(value)
end

export function main(): int
    convert(Result.Err<int, SourceError>(SourceError { code = 1 }))
    return 0
end
