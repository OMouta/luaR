--- expect: run
--- exit: 123
--- spec: LR19
--- spec: LR23.2
--- spec: LR55
ref struct Counter
    value: int
end

@inline
function next<T>(counter: Counter, value: T): int
    counter.value += 1
    return counter.value
end

function digits(a: int, b: int, c: int): int
    return a * 100 + b * 10 + c
end

export function main(): int
    local counter = Counter { value = 0 }
    return digits(next(counter, "a"), next(counter, 2), next(counter, false))
end
