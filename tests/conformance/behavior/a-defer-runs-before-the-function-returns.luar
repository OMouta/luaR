--- expect: run
--- exit: 101
--- trap: integer-overflow
--- spec: LR26
--- spec: LR4.3
struct Counter
    value: u8

    function bump(self): u8
        return self.value + 1
    end
end

export function main(): int
    local counter = Counter { value = 255 }
    defer counter:bump()
    return 0
end
