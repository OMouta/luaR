--- expect: run
--- exit: 0
--- stdout: "1\n2\n3\n"
--- spec: LR12.2
--- spec: LR55
function mark(digit: int): int
    print(digit)
    return digit
end

struct Sample
    first: int = mark(2)
    given: int
    second: int = mark(3)
end

export function main()
    local sample = Sample { given = mark(1) }
end
