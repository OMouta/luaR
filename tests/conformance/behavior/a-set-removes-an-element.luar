    if ids:remove(1) then
        total += 1
    end
    if ids:remove(5) then
        total += 10
    end
    if ids:contains(9) then
        total += 2
    end
    if ids:contains(17) then
        total += 4
    end
    if ids:contains(1) then
        total += 100
    end
    ids:insert(1)
    if ids:contains(1) then
        total += 8
    end
    local walked = 0
    for id in ids do
