export function main(): int
    local scores = Map { alice = 10 }
    local ages = Map.new<int, int>()
    ages[7] = 70
    local total = 0
    if scores:contains("alice") then
        total += 1
    end
    if scores:contains("bob") then
        total += 10
    end
    if ages:contains(7) then
        total += 4
    end
    if ages:frozen():contains(8) then
        total += 20
    end
    return total
end
