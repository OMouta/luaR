--- expect: compile-ok
--- spec: LR12.2
--- spec: LR9.1
struct Address
    city: string
end

struct User
    name: string
    address: Address

    function greeting(self): string
        return self.name
    end
end

function build(name: string): User
    return User { name = name, address = Address { city = "lisbon" } }
end

export function main()
    local user = build("ada")
    local city: string = user.address.city
    local greeting: string = user:greeting()
    print(city, greeting)
end
