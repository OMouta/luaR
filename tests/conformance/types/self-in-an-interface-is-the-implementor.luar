--- expect: compile-ok
--- spec: LR65
--- spec: LR18
--- spec: LR36
interface Comparable
    function compare(self, other: Self): int
end

struct Version implements Comparable
    number: int

    function compare(self, other: Version): int
        return self.number - other.number
    end
end

export function largest<T>(a: T, b: T): T
where T: Comparable
    if a > b then
        return a
    end
    return b
end
