--- expect: compile-ok
--- spec: LR14
--- spec: LR17
--- spec: LR17.2
--- spec: LR17.3
--- spec: LR71
interface Named
    function name(self): string
end

interface Identified
    id: u64
end

struct Request
    path: string
end

struct Response
    status: u16
end

struct User
    id: u64
end

struct LoadError
    message: string
end

function make(): Named & Identified
    return unreachable()
end

function respond(request: Request): Response
    return unreachable()
end

async function respondLater(request: Request): Response
    return unreachable()
end

function record(): { id: u64, email: string? }
    return unreachable()
end

export function main()
    local id: string | u64 = "abc"
    local entity: Named & Identified = make()
    local pair: (int, string) = (1, "one")
    local handler: (Request) -> Response = respond
    local waiting: async (Request) -> Response = respondLater
    local bytes: [u8; 4] = [0, 1, 2, 3]
    local user: { id: u64, email: string? } = record()
    local maybe: Result<User, LoadError>? = nil
    print(id, entity, pair, handler, waiting, bytes, user, maybe)
end
