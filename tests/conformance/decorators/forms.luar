--- expect: compile-ok
--- spec: LR23
--- spec: LR23.2
decorator serializable(target: TypeDeclaration)
end

decorator Json(target: TypeDeclaration)
end

decorator route(target: TypeDeclaration, path: string)
end

decorator auth(target: TypeDeclaration, role: string)
end

@serializable
export struct User
    id: u64
    name: string

    @inline
    function display(self): string
        return self.name
    end
end

@derive(Json, Eq)
export enum Status
    Active
    Retired
end

@repr("C")
struct CTime
    seconds: i64
    nanos: i64
end

@deprecated("Use newApi instead")
function oldApi()
end

struct HttpError
    status: u16
end

function fetch(id: string): Result<User, HttpError>
    return Result.Ok(User { id = 1, name = id })
end

@route("/users/:id")
@auth(role = "admin")
async function getUser(id: string): Result<User, HttpError>
    return fetch(id)
end
