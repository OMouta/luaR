--- expect: run
--- exit: 0
--- stdout: "error\n"
--- spec: LR60
import { readText } from "std/fs"

export function main()
    local result = readText("tests/conformance/fs/does-not-exist.txt")
    match result
        case Result.Ok(_)
            print("read")
        case Result.Err(_)
            print("error")
    end
end
