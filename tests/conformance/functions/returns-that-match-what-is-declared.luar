--- expect: compile-ok
--- spec: LR9.1
function count(): int
    return 3
end

function nothing()
    return
end

function narrowed(flag: bool): int?
    if flag then
        return nil
    end
    return 1
end

export function main()
    local double = function(value: int): int
        return value * 2
    end
    print(count(), double(2), narrowed(true))
    nothing()
end
