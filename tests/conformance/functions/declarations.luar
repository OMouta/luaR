function add(a: int, b: int): int
    return a + b
end

function greet(name: string = "world")
    print(`Hello, {name}`)
end

function printAll(...values: string)
    for value in values do
        print(value)
    end
end

function divide(a: int, b: int): (int, int)
    return (a // b, a % b)
end

function connect(host: string, port: int, secure: bool)
end

export function main()
    connect(host = "localhost", port = 5432, secure = true)
    local (quotient, remainder) = divide(10, 3)
    print(add(1, 2), quotient, remainder)
    greet()
    printAll("a", "b")
end
