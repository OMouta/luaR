struct Profile
    name: string
end

ref struct User
    profile: Profile?
end

function reset(user: User)
    user.profile = nil
end

function label(user: User): string
    if user.profile ~= nil then
        reset(user)
        return user.profile.name
    end
    return "nobody"
end
