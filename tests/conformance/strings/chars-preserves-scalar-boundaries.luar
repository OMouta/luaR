--- expect: run
--- exit: 0
--- spec: LR37
--- spec: LR6.1
--- spec: LR8
--- spec: LR11.3
export function main()
    local chars = "\u{0}\u{7F}\u{80}\u{7FF}\u{800}\u{D7FF}\u{E000}\u{FFFF}\u{10000}\u{10FFFF}":chars()
    assert((chars:next() ?? unreachable()) == '\u{0}')
    assert((chars:next() ?? unreachable()) == '\u{7F}')
    assert((chars:next() ?? unreachable()) == '\u{80}')
    assert((chars:next() ?? unreachable()) == '\u{7FF}')
    assert((chars:next() ?? unreachable()) == '\u{800}')
    assert((chars:next() ?? unreachable()) == '\u{D7FF}')
    assert((chars:next() ?? unreachable()) == '\u{E000}')
    assert((chars:next() ?? unreachable()) == '\u{FFFF}')
    assert((chars:next() ?? unreachable()) == '\u{10000}')
    assert((chars:next() ?? unreachable()) == '\u{10FFFF}')
    assert(chars:next() == nil)

    local empty = "":chars()
    assert(empty:next() == nil)
    assert(empty:next() == nil)

    local first = "é€":chars()
    local second = "é€":chars()
    assert((first:next() ?? unreachable()) == 'é')
    assert((first:next() ?? unreachable()) == '€')
    assert((second:next() ?? unreachable()) == 'é')
    assert(first:next() == nil)
    assert((second:next() ?? unreachable()) == '€')
end
