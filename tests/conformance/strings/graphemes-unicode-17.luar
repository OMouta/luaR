--- expect: run
--- exit: 0
--- spec: LR37
-- Unicode 17.0.0 GraphemeBreakTest.txt, https://www.unicode.org/license.txt

function check(source: string, expected: List<string>)
    local iterator = source:graphemes()
    for cluster in expected do
        assert((iterator:next() ?? unreachable()) == cluster)
    end
    assert(iterator:next() == nil)
    assert(iterator:next() == nil)
end

