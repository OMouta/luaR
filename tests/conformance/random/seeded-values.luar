--- expect: run
--- exit: 0
--- spec: STD12
import { Random } from "std/random"

export function main(): int
    local left = Random.seeded(42)
    local right = Random.seeded(42)
    local known = Random.seeded(42)

    if known:nextU64() ~= 13679457532755275413 then
        return 1
    end

    for _ in 0..<32 do
        if left:nextU64() ~= right:nextU64() then
            return 2
        end
        if left:nextBool() ~= right:nextBool() then
            return 3
        end
    end

    local zero = Random.seeded(0)
    if zero:nextU64() == 0 then
        return 4
    end

    for _ in 0..<32 do
        local value = left:nextFloat()
        if value < 0.0 or value >= 1.0 then
            return 5
        end
    end
    return 0
end
