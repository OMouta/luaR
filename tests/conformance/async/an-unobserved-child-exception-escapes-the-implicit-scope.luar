--- expect: run
--- exit: 0
--- stdout: "child failed\nparent cancelled\n7\n"
--- spec: LR27.2
--- spec: LR27.3
--- spec: STD22
import { Cancelled, yieldNow } from "std/async"

struct Failure
    code: int
end

ref struct Link
    parent: Task<int>?
end

async function child(link: Link)
    local parent = link.parent
    if parent ~= nil then
        parent:cancel()
    end
    try
        local yielded: () = await yieldNow()
    catch error: Cancelled
        print("child failed")
        throw Failure { code = 7 }
    end
end

async function parent(link: Link): int
    try
        local waited: () = await child(link)
    catch error: Cancelled
        print("parent cancelled")
    end
    return 42
end

export async function main()
    local link = Link { parent = nil }
    local task = parent(link)
    link.parent = task
    try
        print(await task)
    catch error: Failure
        print(error.code)
    end
end
