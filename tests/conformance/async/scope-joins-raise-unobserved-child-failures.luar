--- expect: run
--- exit: 0
--- stdout: "cleanup\n7\nafter\n"
--- spec: LR27.2
--- spec: LR26
struct Failure
    code: int
end

async function fail()
    throw Failure { code = 7 }
end

export async function main()
    try
        async scope tasks
            defer print("cleanup")
            tasks:spawn(fail())
        end
    catch error: Failure
        print(error.code)
    end
    print("after")
end
