--- expect: run
--- exit: 0
--- stdout: "closure\n"
--- spec: LR9.2
--- spec: LR27
struct Failure
    message: string
end

export async function main()
    local fail: async () -> int = async function(): int
        throw Failure { message = "closure" }
    end
    local task: Task<int> = fail()
    try
        print(await task)
    catch error: Failure
        print(error.message)
    end
end
