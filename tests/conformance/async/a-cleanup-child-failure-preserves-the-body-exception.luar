--- expect: run
--- exit: 0
--- stdout: "7\n"
--- spec: LR27.2
--- spec: LR27.3
--- spec: LR26
struct Failure
    code: int
end

async function fail()
    throw Failure { code = 11 }
end

async function work()
    try
        throw Failure { code = 7 }
    finally
        local done: () = await fail()
    end
end

export async function main()
    try
        local done: () = await work()
    catch error: Failure
        print(error.code)
    end
end
