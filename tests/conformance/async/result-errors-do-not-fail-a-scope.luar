--- expect: run
--- exit: 0
--- stdout: "joined\n9\n"
--- spec: LR27.2
--- spec: LR25.1
async function child(): Result<int, int>
    return Result.Err<int, int>(9)
end

export async function main()
    local task = child()
    async scope tasks
        tasks:spawn(task)
    end
    print("joined")
    match await task
        case Result.Ok(value) => print(value)
        case Result.Err(error) => print(error)
    end
end
