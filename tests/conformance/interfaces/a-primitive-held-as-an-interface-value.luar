--- expect: run
--- exit: 0
--- stdout: "200\t-7\t1.5\t2.25\tc\tfalse\ttext\t(3)\ntrue\ttrue\tfalse\n"
--- spec: LR18.1
--- spec: LR35
struct Point implements Display
    x: int

    function display(self): string
        return `({self.x})`
    end
end

function show(value: Display): string
    return value:display()
end

function hashOf(value: Hash): u64
    return value:hash()
end

export function main()
    local small: u8 = 200
    local wide: i32 = -7
    local single: f32 = 1.5
    print(
        show(small),
        show(wide),
        show(single),
        show(2.25),
        show('c'),
        show(false),
        show("text"),
        show(Point { x = 3 })
    )
    print(hashOf(1) == hashOf(1), hashOf("a") == hashOf("a"), hashOf(true) == hashOf(false))
end
