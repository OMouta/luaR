--- expect: compile-ok
--- spec: LR89.1
struct User
    id: u64
end

struct Decoder
    strict: bool

    function decode<T>(self, text: string): T
        return unreachable()
    end

    static function parse<T>(text: string): T
        return unreachable()
    end
end

function into<T>(value: int): T
    return unreachable()
end

export function main()
    local json = Decoder { strict = true }
    local text = "{}"
    local value = 0
    local a = 1
    local b = 2
    local c = 3
    local d = 4

    local user = json:decode<User>(text)
    local parsed = Decoder.parse<User>(text)
    local nested = into<Map<string, List<int>>>(value)
    print(user, parsed, nested, a < b, c > d)
end
