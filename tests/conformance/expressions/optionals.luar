--- expect: compile-ok
--- spec: LR8
--- spec: LR56
--- spec: LR25.2
struct Address
    city: string
end

struct User
    name: string
    address: Address?
end

export function loadCity(user: User?): string
    local city = user?.address?.city
    local name = user?.name ?? "Anonymous"
    print(name)
    return city ?? "unknown"
end
