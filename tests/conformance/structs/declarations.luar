--- expect: compile-ok
--- spec: LR12
--- spec: LR12.2
--- spec: LR12.3
--- spec: LR12.4
--- spec: LR31
--- spec: LR42
--- spec: LR43
interface Measured
    function length(self): float
end

export struct Vec2 implements Measured
    x: float
    y: float

    private scratch: float = 0.0

    function length(self): float
        return (self.x * self.x + self.y * self.y) ** 0.5
    end

    static function zero(): Vec2
        return Vec2 { x = 0.0, y = 0.0 }
    end

    property magnitude: float
        get
            return self:length()
        end
    end
end

const struct Point
    x: float
    y: float
end

ref struct Counter
    value: int = 0

    function increment(self)
        self.value += 1
    end

    property doubled: int
        get
            return self.value * 2
        end

        set (newValue)
            self.value = newValue // 2
        end
    end
end

struct Repository<T>
    items: List<T>
end
