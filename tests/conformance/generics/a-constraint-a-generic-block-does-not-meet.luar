--- code: LR0172
--- span: 22:12
--- spec: LR19
--- spec: LR20
interface Eq
    function eq(self, other: Self): bool
end

struct Plain
    id: int
end

extend Search<T> for List<T>
    function includes(self, value: T): bool
    where T: Eq
        return self[0] == value
    end
end

function found(items: List<Plain>, item: Plain): bool
    return items:includes(item)
end
