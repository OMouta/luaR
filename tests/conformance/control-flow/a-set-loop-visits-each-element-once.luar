function count(ids: FrozenSet<int>): int
    local seen = 0
    for id in ids do
        seen += 1
    end
    return seen
end

export function main(): int
    local ids = Set { 3, 4, 3, 4, 5 }
    local total = 0
    for id in ids do
        total += id
    end
    return total + count(ids:frozen())
end
