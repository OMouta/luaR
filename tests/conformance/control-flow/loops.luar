--- expect: compile-ok
--- spec: LR10
--- spec: LR10.1
--- spec: LR10.2
--- spec: LR10.3
--- spec: LR10.5
--- spec: LR10.6
--- spec: LR10.7
--- spec: LR5.3
export function main()
    local total = 0

    for i in 0..<10 do
        if i % 2 == 0 then
            continue
        elseif i > 7 then
            break
        else
            total += i
        end
    end

    while total > 0 do
        total -= 1
    end

    repeat
        total += 1
    until total >= 3

    local rows = [ [1, 2], [3, 4] ]
    local target = 3

    outer: for row in rows do
        for value in row do
            if value == target then
                break outer
            end
        end
    end

    local user = { name = "ada", age = 36 }
    local point = (1, 2)

    local { name, age as years } = user
    local (x, y) = point
    print(total, name, years, x, y)
end
