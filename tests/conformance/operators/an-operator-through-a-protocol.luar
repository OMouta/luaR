--- expect: compile-ok
--- spec: LR36
--- spec: LR76
struct Vec2
    x: float
    y: float

    function add(self, other: Vec2): Vec2
        return Vec2 { x = self.x + other.x, y = self.y + other.y }
    end

    function neg(self): Vec2
        return Vec2 { x = -self.x, y = -self.y }
    end
end

export function sum(a: Vec2, b: Vec2): Vec2
    return -(a + b)
end
