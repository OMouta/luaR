--- expect: compile-ok
--- spec: §16.1
--- spec: §16.2
--- spec: §16.3
export function main()
    match message
        case Message.Move { x, y }
            moveTo(x, y)

        case Message.Write(text) if text ~= ""
            print(text)

        case [command, ...rest]
            run(command, rest)

        case 0..<10
            small()

        case Direction.North | Direction.South
            vertical()

        case value is string
            print(value)

        case _
            other()
    end

    local text = match result
        case Result.Ok(value) => value
        case Result.Err(error) => "failed"
    end

    print(text)
end
