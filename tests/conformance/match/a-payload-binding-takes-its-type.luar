--- expect: run
--- exit: 0
--- stdout: "3\n"
--- spec: LR16.2
--- spec: LR15.2
enum Message
    Quit
    Move { x: int, y: int }
end

export function main()
    local message = Message.Move { x = 1, y = 2 }
    match message
        case Message.Move { x, y }
            print(x + y)
        case Message.Quit
            print("quit")
    end
end
